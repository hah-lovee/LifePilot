# --- Postgres ---
POSTGRES_USER=life_pilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=life_pilot

# --- Backend (mounted as backend/.env via env_file) ---
DATABASE_URL=postgresql+psycopg://life_pilot:change-me@postgres:5432/life_pilot
SECRET_KEY=generate-a-long-random-string
REGISTRATION_CODE=pick-a-private-invite-code
CORS_ORIGINS=["https://your-domain.example"]
# Investments integration (trading-keys-api), see docs/ADMIN_GUIDE.md.
# INVESTMENTS_API_URL should point at the trading-keys-api container's
# internal docker network address (e.g. http://trading-api:8000), not
# localhost — they must share a docker network for this to resolve.
INVESTMENTS_API_URL=http://trading-api:8000
INVESTMENTS_API_KEY=copy-the-API_KEY-line-from-trading-keys-api/data/init/tokens.env

# --- Telegram reminders ---
# Create a bot via @BotFather in Telegram (/newbot), paste the token below.
# TELEGRAM_BOT_USERNAME is the bot's @handle without the "@", used to build
# the t.me/<username>?start=<code> linking link shown on the Settings page.
# NOTE: the backend no longer polls Telegram for updates — the voice-bot
# container is the single getUpdates consumer and forwards "/start <code>"
# back here. The backend still uses this token to SEND reminders, which is
# safe: only getUpdates is exclusive per token.
TELEGRAM_BOT_TOKEN=token-from-@BotFather
TELEGRAM_BOT_USERNAME=your_bot_username_without_at_sign

# --- Voice bot (voice-bot/) ---
# Shared secret the bot presents on /api/integrations/*. Generate a long
# random string; rotating this line revokes the bot's access. Leave EMPTY to
# disable the integration API entirely.
INTEGRATION_API_KEY=generate-a-long-random-string
# Your own Telegram user id (@userinfobot will tell you). Only this account
# may file day reports; everyone else gets a polite refusal. Note that the
# /start linking flow stays open to other Life Pilot users, so they can still
# link Telegram for habit reminders.
ALLOWED_TELEGRAM_ID=123456789

# --- Voice bot: optional overrides (sensible defaults, usually leave unset) ---
# Whisper/Ollama live on the Windows host and are found via the VM's default
# gateway, re-read periodically so a host reboot (which renumbers the Hyper-V
# Default Switch) heals by itself. Set HOST_GW only to pin it by hand, or
# WHISPER_URL/OLLAMA_URL to bypass discovery completely.
# HOST_GW=
# WHISPER_URL=
# OLLAMA_URL=
# WHISPER_PORT=8100
# OLLAMA_PORT=11434
# OLLAMA_MODEL=qwen2.5:7b
# A report dictated before this local hour is filed under the previous day.
# DAY_ROLLOVER_HOUR=4
# Comma-separated; extend freely. A "word" of one repeated letter (эээ) matches
# any run of two or more, since Whisper spells hesitations inconsistently.
# FILLER_WORDS=ну,это,эээ,как бы,типа,короче,в общем,блин,вот,значит,собственно,походу,реально
# FILLER_LOG_PATH=/data/fillers.jsonl
# This network filters most of Telegram's addresses, and which ones survive
# changes over time, so the bot probes DNS results plus a fallback list and
# uses the first that answers. Override the fallback list only if Telegram
# renumbers; set TELEGRAM_PIN_IP=false to use plain DNS on an unfiltered link.
# TELEGRAM_PIN_IP=true
# TELEGRAM_API_IPS=149.154.167.222,149.154.175.50,91.108.4.196

# --- Frontend ---
# Leave empty: every frontend request already starts with /api itself
# (see frontend/src/lib/api.ts), so this is just the base to prefix it with.
# The reverse proxy (Caddy/nginx) routes /api/* to the backend container.
NEXT_PUBLIC_API_URL=

# --- Reverse proxy ---
DOMAIN=your-domain.example
