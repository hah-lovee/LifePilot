# Base is python:3.12-slim purely because it is already in the local cache:
# Docker Hub and ghcr.io both refuse connections from this network, so pulling
# a ready-made xray image is not possible — and the VM has no registry access
# at all, so the image reaches it via docker save/load regardless.
FROM python:3.12-slim

ARG BUILD_REF=unknown

# Copied rather than downloaded during the build: there is no outbound network
# in the build container either (apt-get fails), so the binary is fetched on
# the host first — see fetch-xray.sh.
COPY bin/xray /usr/local/bin/xray
RUN chmod +x /usr/local/bin/xray && echo "$BUILD_REF" > /BUILD_REF

# Mounted read-only from the host. Generated by generate-config.py and holding
# subscription credentials, so deliberately not baked into the image.
VOLUME ["/etc/xray"]

EXPOSE 8889 1080

CMD ["xray", "run", "-c", "/etc/xray/config.json"]
